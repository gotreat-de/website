# Dependencies and build output are reinstalled and rebuilt inside the image.
node_modules
.next
out
tsconfig.tsbuildinfo

# Local env files and secrets are never baked into the image.
.env*

# Version control, CI, editor settings, agent worktrees, OS clutter.
.git
.github
.vscode
.claude
.DS_Store

# Docs are not needed to build the site.
*.md
docs
